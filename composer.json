{
    "name": "krausgebaut/kongtent-bundle",
    "type": "symfony-bundle",
    "description": "Reads contents out of kongtent and renders their blocks in a Symfony site",
    "license": "MIT",
    "homepage": "https://github.com/krausgebaut/kongtent-bundle",
    "support": {
        "issues": "https://github.com/krausgebaut/kongtent-bundle/issues",
        "source": "https://github.com/krausgebaut/kongtent-bundle"
    },
    "require": {
        "php": ">=8.4",
        "league/commonmark": "^2.7",
        "league/config": "^1.2",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/cache-contracts": "^3.6",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-client-contracts": "^3.6",
        "symfony/http-kernel": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.3.1",
        "symfony/cache": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Krausgebaut\\KongtentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Krausgebaut\\KongtentBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
